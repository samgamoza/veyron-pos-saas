# ============================================================================
# Veyron POS — PRODUCTION environment template
# Copy to `.env` on the server (or set as real environment variables) and fill in.
# This file is a TEMPLATE — never commit real secrets. `.env` is git-ignored.
# Generate strong secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================

# --- Core ---------------------------------------------------------------------
APP_ENV=production
FLASK_DEBUG=0
# REQUIRED. App refuses to boot in production without a strong, non-default value.
SECRET_KEY=

# --- First-boot super admin ---------------------------------------------------
# Used ONLY on first boot when no super-admin exists yet. PIN must be >= 8 chars.
# Change/rotate after first login. Safe to blank out once the account exists.
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PIN=

# --- Database (PostgreSQL) ----------------------------------------------------
# REQUIRED in production. Format:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
# CRITICAL for tenant isolation: this USER must be a NORMAL (non-superuser) role,
# otherwise Postgres Row-Level Security is silently bypassed. After the schema is
# created, run:  python tools/apply_rls.py
DATABASE_URL=
# Leave SQLITE_DATABASE_PATH unset in production (only used when DATABASE_URL is empty).
# SQLITE_DATABASE_PATH=

# --- docker-compose only ------------------------------------------------------
# Used by docker-compose.yml to provision Postgres and build DATABASE_URL.
# Ignore these if you are not using compose (they are not read by the app).
POSTGRES_DB=veyron
POSTGRES_SUPERUSER=veyron_admin
POSTGRES_SUPERUSER_PASSWORD=
# The app connects as this NON-superuser role (created on first DB init).
APP_DB_USER=veyron_app
APP_DB_PASSWORD=
# Host port to publish the app on.
APP_PORT=8000

# --- Payment credential encryption --------------------------------------------
# Key used to encrypt per-tenant payment credentials at rest. Set a DEDICATED value
# (not equal to SECRET_KEY) so rotating the session key never breaks stored creds.
# WARNING: if you change this later, previously stored payment credentials can no
# longer be decrypted. Set once and keep it stable.
PAYMENT_CREDENTIALS_SECRET=

# --- PayMongo (PH payments: GCash, Maya, QRPH, cards) -------------------------
# Platform-level fallback keys. Per-tenant keys (encrypted store) override these.
# Use sk_live_/pk_live_ in production; sk_test_/pk_test_ in staging.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# Webhook signing secret (whsk_...) — required to verify incoming webhooks.
PAYMONGO_WEBHOOK_SECRET=

# --- Rate limiting ------------------------------------------------------------
# In-process memory is fine for ONE gunicorn worker. With multiple workers, point
# this at Redis so limits are shared across processes:
#   RATELIMIT_STORAGE_URI=redis://localhost:6379
RATELIMIT_STORAGE_URI=

# --- Storage paths ------------------------------------------------------------
# Use durable, writable locations (a mounted disk on Proxmox/Render, not ephemeral).
BACKUP_DIR=/data/backups
PRODUCT_IMAGES_DIR=/data/images/products

# --- Storefront / multi-tenant subdomains -------------------------------------
# Base host used to build public storefront URLs, e.g. shop.example.com or
# example.com (tenants resolve via subdomain). Match your wildcard DNS + TLS cert.
STORE_FRONT_BASE_HOST=

# --- Owner email alerts (optional but recommended) ----------------------------
ALERT_TO_EMAIL=
ALERT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
