// Mirrors sql/etown_marketplace_mvp_bootstrap.sql (standalone Postgres MVP).
// Generate client: npm run prisma:generate:etown-mvp-bootstrap
// Default prisma/schema.prisma remains aligned with Flask (wider schema).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-etown-mvp-bootstrap"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   Int       @id @default(autoincrement())
  name                 String
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  publicBusinessName   String?   @map("public_business_name")
  publicSubtitle       String?   @map("public_subtitle")
  publicDescription    String?   @map("public_description")
  publicAddress        String?   @map("public_address")
  publicPhone          String?   @map("public_phone")
  publicCoverImage     String?   @map("public_cover_image")
  publicLogoImage      String?   @map("public_logo_image")
  publicOpeningHours   String?   @map("public_opening_hours")
  storefrontVisibility String    @default("hidden") @map("storefront_visibility")
  marketplaceEnabled   Int       @default(0) @map("marketplace_enabled")
  products             Product[]
  orders               Order[]
  orderItems           OrderItem[]

  @@map("tenants")
}

model Product {
  id                     Int              @id @default(autoincrement())
  tenantId               Int              @map("tenant_id")
  name                   String
  sku                    String?
  price                  Decimal          @default(0) @db.Decimal(12, 2)
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  isPublic               Int              @default(0) @map("is_public")
  marketplaceDescription String?          @map("marketplace_description")
  marketplaceImagePath   String?          @map("marketplace_image_path")
  marketplaceSortOrder   Int              @default(0) @map("marketplace_sort_order")
  marketplacePublishedAt String?          @map("marketplace_published_at")
  slug                   String?
  tenant                 Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productVariants        ProductVariant[]
  orderItems             OrderItem[]

  @@index([tenantId], map: "products_tenant_id_idx")
  @@index([slug], map: "products_slug_idx")
  @@map("products")
}

model ProductVariant {
  id        Int         @id @default(autoincrement())
  productId Int         @map("product_id")
  name      String
  price     Decimal?    @db.Decimal(12, 2)
  stockQty  Int         @default(0) @map("stock_qty")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId], map: "product_variants_product_id_idx")
  @@map("product_variants")
}

model Customer {
  id        Int               @id @default(autoincrement())
  email     String?
  phone     String
  fullName  String            @map("full_name")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  addresses CustomerAddress[]
  orders    Order[]

  @@index([phone], map: "customers_phone_idx")
  @@map("customers")
}

model CustomerAddress {
  id            Int       @id @default(autoincrement())
  customerId    Int       @map("customer_id")
  label         String?
  province      String
  municipality  String
  barangay      String
  addressLine   String    @map("address_line")
  landmarkNotes String?   @map("landmark_notes")
  isPrimary     Int       @default(0) @map("is_primary")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([customerId], map: "customer_addresses_customer_id_idx")
  @@map("customer_addresses")
}

model Order {
  id             Int              @id @default(autoincrement())
  customerId     Int              @map("customer_id")
  tenantId       Int              @map("tenant_id")
  source         String           @default("marketplace")
  status         String           @default("pending")
  paymentMethod  String           @default("cash") @map("payment_method")
  subtotal       Decimal          @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal          @default(0) @map("tax_amount") @db.Decimal(12, 2)
  deliveryFee    Decimal          @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  totalAmount    Decimal          @default(0) @map("total_amount") @db.Decimal(12, 2)
  customerNotes  String?          @map("customer_notes")
  merchantNotes  String?          @map("merchant_notes")
  addressId      Int?             @map("address_id")
  requestedAt    DateTime         @default(now()) @map("requested_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  storefrontUrl  String?          @map("storefront_url")
  customer       Customer         @relation(fields: [customerId], references: [id])
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  address        CustomerAddress? @relation(fields: [addressId], references: [id])
  items          OrderItem[]

  @@index([customerId], map: "orders_customer_id_idx")
  @@index([tenantId], map: "orders_tenant_id_idx")
  @@index([status], map: "orders_status_idx")
  @@map("orders")
}

model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int             @map("order_id")
  productId   Int             @map("product_id")
  variantId   Int?            @map("variant_id")
  tenantId    Int             @map("tenant_id")
  productName String          @map("product_name")
  quantity    Int
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal         @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime        @default(now()) @map("created_at")
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  tenant      Tenant          @relation(fields: [tenantId], references: [id])

  @@index([orderId], map: "order_items_order_id_idx")
  @@map("order_items")
}
