APP_ENV=production
# REQUIRED in production. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production with a missing or dev fallback key.
SECRET_KEY=replace-this-with-a-long-random-secret
# Initial platform super-admin, created on first boot ONLY when no super-admin
# exists yet (production). PIN must be at least 8 characters. Rotate/change after
# first login. In development, the demo owner/admin/cashier accounts are seeded
# automatically instead and these are ignored.
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PIN=
FLASK_HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
# Database — one shared store for Veyron POS and eTown (same file or same Postgres DB).
# Leave DATABASE_URL empty to use SQLite (SQLITE_DATABASE_PATH).
# For PostgreSQL, set a DSN (no sqlite prefix). Example:
#   DATABASE_URL=postgresql://user:password@localhost:5432/veyron_pos
# The app sets DATABASE_ENGINE=postgres when DATABASE_URL is set and is not sqlite.
DATABASE_URL=
SQLITE_DATABASE_PATH=instance/pos.db
BACKUP_DIR=backups
# Rate-limit storage. Default is in-process memory (fine for a single worker).
# With multiple gunicorn workers, point this at Redis so limits are shared:
#   RATELIMIT_STORAGE_URI=redis://localhost:6379
RATELIMIT_STORAGE_URI=
# PayMongo (PH payments: GCash, Maya, QRPH, cards). Use sk_test_/pk_test_ in dev.
# Platform-level fallback; per-tenant keys (encrypted store) override these when set.
# Never commit real keys — this file is a template only.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# Webhook signing secret (whsk_...) from the PayMongo dashboard; required to verify
# incoming webhook signatures.
PAYMONGO_WEBHOOK_SECRET=
ALERT_TO_EMAIL=
ALERT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
